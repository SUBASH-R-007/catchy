{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cachelab.io/schemas/metrics/v2.json",
  "title": "CacheLab metrics stream payload (schema v2)",
  "description": "Payload of each SSE event named 'metrics' on GET /api/metrics/stream, sent every 500 ms. Rates are 0-1. Counters are monotonic except after reset-stats. 'events' holds only removals since the previous tick (at most 50).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "caches", "groups", "simulation", "events"],
  "properties": {
    "ts": { "type": "integer", "description": "Server time of this tick, epoch milliseconds." },
    "caches": { "type": "array", "items": { "$ref": "#/$defs/cache" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "simulation": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/simulation" }]
    },
    "events": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "policy": { "type": "string", "enum": ["LRU", "LFU", "LFU_DECAY"] },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "pattern": {
      "type": "string",
      "enum": [
        "UNIFORM",
        "ZIPF",
        "SCAN_POLLUTION",
        "LOOP",
        "SHIFTING_HOTSPOT",
        "TTL_BURST",
        "FORMULARY",
        "PROVIDER_DIRECTORY"
      ]
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "group",
        "policy",
        "size",
        "capacity",
        "hits",
        "misses",
        "hitRate",
        "hitRateWindow10s",
        "evictions",
        "expirations",
        "opsPerSec",
        "getP50Micros",
        "getP99Micros",
        "dbCallsAvoided",
        "latencySavedMs",
        "estCostSaved"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "policy": { "$ref": "#/$defs/policy" },
        "size": { "$ref": "#/$defs/count" },
        "capacity": { "type": "integer", "minimum": 1 },
        "hits": { "$ref": "#/$defs/count" },
        "misses": { "$ref": "#/$defs/count" },
        "hitRate": { "$ref": "#/$defs/rate", "description": "Cumulative hits / (hits + misses)." },
        "hitRateWindow10s": {
          "$ref": "#/$defs/rate",
          "description": "Hit rate over the last 20 ticks (10 s)."
        },
        "evictions": { "$ref": "#/$defs/count" },
        "expirations": { "$ref": "#/$defs/count" },
        "opsPerSec": { "type": "number", "minimum": 0 },
        "getP50Micros": { "type": "number", "minimum": 0 },
        "getP99Micros": { "type": "number", "minimum": 0 },
        "dbCallsAvoided": { "$ref": "#/$defs/count", "description": "Estimate: equals hits." },
        "latencySavedMs": {
          "type": "number",
          "minimum": 0,
          "description": "Estimate: hits x mean simulated DB latency."
        },
        "estCostSaved": {
          "type": "number",
          "minimum": 0,
          "description": "Estimate: dbCallsAvoided / 1000 x cost per 1000 calls."
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "caches", "optimalHitRate", "advisor"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "caches": { "type": "array", "items": { "type": "string" } },
        "optimalHitRate": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rate" }],
          "description": "Belady (MIN) hit rate over the group's recorded trace; an upper bound."
        },
        "advisor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/advisor" }] }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "recommended", "expectedGainPts", "windowSec"],
      "properties": {
        "current": { "$ref": "#/$defs/policy" },
        "recommended": { "$ref": "#/$defs/policy" },
        "expectedGainPts": { "type": "number", "minimum": 0 },
        "windowSec": { "type": "integer", "minimum": 1 }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "running",
        "group",
        "pattern",
        "act",
        "phaseIndex",
        "phaseCount",
        "phaseCaption",
        "phaseStartedTs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "running": { "type": "boolean" },
        "group": { "type": "string", "minLength": 1 },
        "pattern": { "$ref": "#/$defs/pattern" },
        "act": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 4 }],
          "description": "Guided demo act number, or null for a free-running simulation."
        },
        "phaseIndex": { "type": "integer", "minimum": 0 },
        "phaseCount": { "type": "integer", "minimum": 1 },
        "phaseCaption": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "phaseStartedTs": { "type": "integer" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "cache", "key", "cause"],
      "properties": {
        "ts": { "type": "integer" },
        "cache": { "type": "string", "minLength": 1 },
        "key": { "type": "string" },
        "cause": { "type": "string", "enum": ["EXPLICIT", "REPLACED", "EVICTED", "EXPIRED"] }
      }
    }
  }
}
