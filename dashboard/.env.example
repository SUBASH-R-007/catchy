# Copy to .env.local to override. None of these are required.

# Where the Vite dev/preview server proxies /api (read from the shell environment, not from .env files):
#   CATCHY_API_URL=http://localhost:8090

# Base URL prepended to /api/v1/... (default: same origin, i.e. relative URLs through the proxy)
# VITE_API_BASE=

# Serve an in-browser mock API instead of the real backend (what `npm run dev:mock` sets)
# VITE_MOCK_API=true

# Mock only: set to false to make /auth/demo-login return 404, like a backend with CATCHY_DEMO_MODE=false
# VITE_MOCK_DEMO_MODE=true
