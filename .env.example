# CATCHY - AcentraCache Insight: local configuration.
# Copy to `.env` (scripts do this automatically on first run). `.env` is git-ignored.
# Every value below is a DEVELOPMENT PLACEHOLDER. Replace all of them outside a laptop demo.

# ---------------- telemetry-service ----------------
# Spring profile: "local" = in-memory H2 (default, zero setup); "postgres" = PostgreSQL from docker-compose.
SPRING_PROFILES_ACTIVE=local
CATCHY_DB_PORT=5433
CATCHY_DB_NAME=catchy
CATCHY_DB_USER=catchy
CATCHY_DB_PASSWORD=change-me-db-password
CATCHY_DB_URL=jdbc:postgresql://localhost:5433/catchy

# HMAC secret for dashboard session tokens. Leave blank to generate a random one at each start (sessions reset on restart).
CATCHY_TOKEN_SECRET=

# Demo mode enables one-click role login on the dashboard (POST /api/v1/auth/demo-login). Set to false anywhere shared.
CATCHY_DEMO_MODE=true

# Password login for the three dashboard roles. A blank password disables password login for that role.
CATCHY_ADMIN_PASSWORD=demo-admin-change-me
CATCHY_ENGINEER_PASSWORD=demo-engineer-change-me
CATCHY_VIEWER_PASSWORD=demo-viewer-change-me

# Browser origin allowed to call the API (CORS).
CATCHY_DASHBOARD_ORIGIN=http://localhost:5173

# Seed the demo projects/applications and register these API keys (format acc_<8 hex>_<32 hex>).
# They are dev-only placeholders, not secrets. Create real keys in the dashboard (Application > API keys).
CATCHY_SEED_ENABLED=true
CATCHY_SEED_CLAIMS_API_KEY=acc_c1a10001_7f3e9b2d4a6c81e0f5d7b3a9c2e4f601
CATCHY_SEED_ELIGIBILITY_API_KEY=acc_e1160002_1b8d5f3a7c9e2d406b8a1c3e5f7092d4

# Policy Arena rules (deterministic advisor)
CATCHY_ADVISOR_MIN_REQUESTS=100
CATCHY_ADVISOR_MIN_IMPROVEMENT_PERCENT=5.0
CATCHY_ADVISOR_COOLDOWN=PT5M

# Optional, OFF by default: local Ollama only writes a human-readable explanation from aggregate numbers.
CATCHY_OLLAMA_ENABLED=false
CATCHY_OLLAMA_URL=http://localhost:11434
CATCHY_OLLAMA_MODEL=llama3.2

# ---------------- demo services ----------------
CATCHY_TELEMETRY_URL=http://localhost:8090
CATCHY_ENVIRONMENT=staging
CATCHY_CLAIMS_API_KEY=acc_c1a10001_7f3e9b2d4a6c81e0f5d7b3a9c2e4f601
CATCHY_ELIGIBILITY_API_KEY=acc_e1160002_1b8d5f3a7c9e2d406b8a1c3e5f7092d4
# Application salt for cache-key fingerprints (keeps fingerprints unlinkable across applications).
CATCHY_KEY_SALT=change-me-fingerprint-salt

# ---------------- ports ----------------
CATCHY_TELEMETRY_PORT=8090
CATCHY_CLAIMS_PORT=8091
CATCHY_ELIGIBILITY_PORT=8092
CATCHY_DASHBOARD_PORT=5173
